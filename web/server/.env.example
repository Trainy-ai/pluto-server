# Storage
STORAGE_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
STORAGE_ACCESS_KEY_ID=your_access_key_id
STORAGE_SECRET_ACCESS_KEY=your_secret_access_key
STORAGE_BUCKET=your_bucket_name
STORAGE_REGION=us-east-1

# Clickhouse
CLICKHOUSE_URL=http://clickhouse:8123
CLICKHOUSE_USER=nope
CLICKHOUSE_PASSWORD=nope

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postgres"
DATABASE_DIRECT_URL="postgresql://postgres:postgres@localhost:5432/postgres"

# Auth
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# URLs & CORS
PUBLIC_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3001
BETTER_AUTH_SECRET=secret
# Optional: comma-separated list of additional allowed origins for CORS/auth
# ADDITIONAL_ORIGINS=https://example.com,https://api.example.com

# Linear OAuth (optional - for Linear integration)
# LINEAR_OAUTH_CLIENT_ID=""
# LINEAR_OAUTH_CLIENT_SECRET=""

# Chat with data private preview. Base URL should include the provider's API
# prefix when required (for example http://model-host:8000/v1).
# OPENAI_COMPATIBLE_BASE_URL="http://model-host:8000/v1"
# OPENAI_COMPATIBLE_API_KEY="optional-for-local-endpoints"
# OPENAI_COMPATIBLE_MODEL="your-served-model-name"
# CHAT_ENABLED_ORG_IDS="org-id-1,org-id-2" # Use * to enable every org
# CHAT_MAX_OUTPUT_TOKENS="1200"
# CHAT_REQUEST_TIMEOUT_MS="120000"
# CHAT_CAPTURE_CONTENT="false" # Keep false unless trace content retention is approved
# CHAT_PROMPT_VERSION="project-context-v1"

# Hosted Langfuse. Chat remains available if these are absent or tracing fails.
# LANGFUSE_BASE_URL="https://langfuse.example.com"
# LANGFUSE_PUBLIC_KEY="pk-lf-..."
# LANGFUSE_SECRET_KEY="sk-lf-..."

# Deployment/Environment Specific
IS_DOCKER="false"

# Automatically set environment variables
NODE_ENV=""
VERCEL=""
