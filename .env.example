# Chat with data private preview (model deployment is external to this stack)
# OPENAI_COMPATIBLE_BASE_URL=http://host.docker.internal:8000/v1
# OPENAI_COMPATIBLE_API_KEY=optional-for-local-endpoints
# OPENAI_COMPATIBLE_MODEL=your-served-model-name
# CHAT_ENABLED_ORG_IDS=org-id-1,org-id-2
# CHAT_MAX_OUTPUT_TOKENS=1200
# CHAT_REQUEST_TIMEOUT_MS=120000
# CHAT_CAPTURE_CONTENT=false
# CHAT_PROMPT_VERSION=project-context-v1

